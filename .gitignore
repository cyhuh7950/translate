# 비밀값 — LLM 프로바이더 API 키, 엔진 접근 키
config/secrets.env
*.key
*.pem
*.keystore
*.jks
*.p12
*.pfx

# 로컬 환경 파일과 비밀 설정
.env
.env.*
!.env.example
**/*.local.env

# 공개 매뉴얼을 제외한 프로젝트 문서
*.md
!README.md
!**/README.md

# 서버별로 다른 설정 (필요 시 config/*.example 을 복사해 쓴다)
config/*.local.yaml

# 파이썬
__pycache__/
*.py[cod]
*.egg-info/
.venv/
*/.venv/

# 작업 산출물
*.wav
*.mp3
*.log

# 임시 비교용 샘플 (버전관리 대상 아님)
web/static/samples/

# 진단용 세그먼트 덤프 (diagnostics.save_segments). 사용자 음성이 들어 있다.
diagnostics/

# 쓰기 가능한 데이터 볼륨. 등록된 목소리(voice print)가 들어 있다 —
# 임베딩은 생체정보에 준하는 개인정보이므로 버전관리에 올리지 않는다.
data/
