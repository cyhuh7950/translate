# 이 파일을 secrets.env 로 복사한 뒤 값을 채운다.
#   cp config/secrets.env.example config/secrets.env && chmod 600 config/secrets.env
#
# 설정 파일(yaml)에는 키를 적지 않는다. yaml 은 버전관리에 들어가고 이 파일은 안 들어간다.
# yaml 에서는 api_key_env 로 여기 이름만 가리킨다.

# ── 오케스트레이터 자신의 인증 ──────────────────────────────
# 비우면 인증 없이 열린다. 외부에 노출한다면 반드시 채울 것.
#   openssl rand -hex 24
TRANSLATE__auth__api_key=

# ── 엔진 접근 키 ────────────────────────────────────────────
# voice 저장소의 각 엔진 secrets.env 에 있는 값과 같아야 한다.
ENGINE_KEY_WHISPER=
ENGINE_KEY_MOONSHINE=
ENGINE_KEY_SUPERTONIC=
ENGINE_KEY_MELOTTS=
ENGINE_KEY_WHISPER_GPU=

# ── LLM 프로바이더 키 ───────────────────────────────────────
# 채운 것만 사용 가능으로 표시된다. 전부 채울 필요는 없다.
LLM_KEY_CEREBRAS=
LLM_KEY_GROQ=
LLM_KEY_MISTRAL=
LLM_KEY_OPENROUTER=
LLM_KEY_UPSTAGE=
LLM_KEY_OPENAI=
LLM_KEY_GEMINI=
LLM_KEY_ANTHROPIC=
LLM_KEY_OLLAMA=
ENGINE_KEY_SPEAKER=
