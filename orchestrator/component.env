# 오케스트레이터 컴포넌트 메타 + 컨테이너 런타임 설정.
#
# 애플리케이션 설정(엔진 목록, 프로바이더, 프로필, 기본값)은 여기가 아니라 ../config/ 에 있다.
# 이 파일은 "컨테이너를 어떻게 띄우는가"만 담는다.

COMPONENT_NAME=orchestrator
COMPONENT_KIND=orchestrator
PORT=8401

# 0.0.0.0 이면 호스트 포트로 외부 접근 가능. NPM 경유로만 쓸 거면 127.0.0.1.
BIND_HOST=127.0.0.1

# 컨테이너 안에서 설정 디렉터리 경로
TRANSLATE_CONFIG_DIR=/config

# 진단용 세그먼트 덤프를 둘 호스트 경로 (compose 파일 기준 상대경로).
# 실제로 저장할지는 config/defaults.yaml 의 diagnostics.save_segments 가 정한다.
DIAGNOSTICS_DIR=../diagnostics

MEM_LIMIT=1g
