# 웹 클라이언트 컴포넌트 메타 + 컨테이너 런타임 설정.
#
# orchestrator/component.env 와 같은 규약이다. translatectl.sh 는 폴더에
# component.env 와 docker-compose.yml 이 있으면 컴포넌트로 인식한다.
#
# 여기 있는 값은 전부 nginx 설정으로 흘러 들어간다. 소스(정적 파일·설정 템플릿)에는
# 주소도 포트도 키도 없다.

COMPONENT_NAME=web
COMPONENT_KIND=web

# 호스트에 노출할 포트 (translatectl.sh 가 상태 확인에 쓴다)
PORT=8402
# 컨테이너 안에서 nginx 가 듣는 포트
WEB_LISTEN_PORT=8402

# 0.0.0.0 이면 호스트 포트로 외부 접근 가능. NPM 경유로만 쓸 거면 127.0.0.1.
# 브라우저 마이크는 보안 컨텍스트(HTTPS 또는 localhost)에서만 열린다.
# 다른 기기에서 쓰려면 NPM 으로 HTTPS 를 붙일 것.
BIND_HOST=0.0.0.0

# 오케스트레이터에 닿는 방법. 컨테이너 이름이든 사설망 IP 든 공개 도메인이든
# 여기서는 그냥 URL 문자열이다 — 엔진 레지스트리와 같은 원칙.
ORCHESTRATOR_URL=http://translate-orchestrator:8401

# 오케스트레이터 API 키를 담고 있는 "환경변수의 이름".
# 키 값 자체는 config/secrets.env 에만 있고 이 파일에도 이미지에도 없다.
# 엔진/프로바이더 설정의 api_key_env 와 같은 방식이다.
# 비워 두거나 그 변수가 비어 있으면 인증 헤더를 붙이지 않는다.
ORCHESTRATOR_API_KEY_ENV=TRANSLATE__auth__api_key

# 오디오 업로드가 있으므로 넉넉히. 0 이면 무제한.
MAX_UPLOAD_SIZE=128m

# STT+LLM+TTS 를 CPU 로 돌면 10초를 훌쩍 넘는다. 프록시가 먼저 끊으면 안 된다.
PROXY_READ_TIMEOUT=600s

MEM_LIMIT=128m
