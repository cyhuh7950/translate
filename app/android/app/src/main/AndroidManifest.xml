<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      실시간 통역 화면이 마이크를 연다 (react-native-audio-api 의 AudioRecorder).
      선언만으로는 부족하고 실행 중에도 물어봐야 한다 — ui/LiveScreen.tsx 의 PermissionsAndroid.

      라이브러리 문서가 함께 언급하는 MODIFY_AUDIO_SETTINGS / FOREGROUND_SERVICE 는 넣지 않았다.
      전자는 오디오 모드·스피커를 바꿀 때 필요한데 이 라이브러리는 오디오 포커스만 요청하고
      (requestAudioFocus 에는 이 권한이 필요 없다), 후자는 잠금화면 재생 알림
      (PlaybackNotificationManager)을 쓸 때의 것이라 이 앱은 쓰지 않는다.
      필요해지면 그때 하나씩 더한다.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      언어 학습 알림 (DESIGN.md §15) — @notifee/react-native 로 기기가 스스로 예약한다
      (서버 푸시 없음). Android 13(API 33) 이상은 이 권한을 런타임에도 물어야 뜬다
      (notifications.ts 의 ensurePermission). 정확한 시각을 요구하지 않으므로
      SCHEDULE_EXACT_ALARM 은 넣지 않았다 — 기본 트리거로 몇 분 밀리는 것은 감내한다.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 재부팅 후에도 예약이 살아남게 한다 (notifee가 제공하는 부팅 리시버). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
