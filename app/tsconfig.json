{
  // React Native 앱 코드용 설정. IDE 와 RN 도구(Metro·eslint·jest)가 이름만 보고 집는
  // 파일이므로 이 이름을 RN 에 준다.
  //
  // `src/api` 도 여기에 들어온다 — 앱이 실제로 import 하는 코드이니 함께 봐야 한다.
  // 다만 이 설정에는 RN·jest 타입이 다 들어 있어서 **이식성은 여기서 지켜지지 않는다.**
  // 그 일은 tsconfig.api.json 이 한다 (`types: []`). `npm run typecheck` 가 셋을 다 돌린다.
  //
  // test/ 는 제외한다. 그 안은 node:fs·process 를 쓰는데 이 설정에는 node 타입이 없다.
  // dist/ 도 제외한다 — 스모크 빌드 산출물의 .d.ts 가 `**/*.ts` 에 걸린다.
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    // app.config.json 을 import 해서 서버 주소를 읽는다 (App.tsx).
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "test", "dist"]
}
